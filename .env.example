# ECHO SCOPE local config -- copy to .env and edit.
#
#     cp .env.example .env
#     nano .env
#     ./start.sh
#
# .env is git-ignored. start.sh sources it before launching the kiosk,
# so every key=value in here becomes an environment variable for the
# Python process and its child threads.
#
# Lines starting with '#' are comments. No quotes needed; whitespace
# around '=' is fine.


# ---- OpenAI ----------------------------------------------------------
# Primary chat backend. Replace <API_KEY> with your key.
# Leave blank to fall back to local hailo-ollama (qwen3:1.7b on the
# Hailo-10H).
OPENAI_API_KEY=<API_KEY>


# ---- Admin auth ------------------------------------------------------
# /admin needs HTTP basic auth. If KIOSK_ADMIN_PASS is unset, start.sh
# generates a random one at every launch (printed in the banner). Set
# something stable here for a persistent password.
KIOSK_ADMIN_USER=admin
# KIOSK_ADMIN_PASS=change-me


# ---- Kiosk web port --------------------------------------------------
# Defaults to 8090. Bump it if 8090 clashes with something else on the
# Pi.
# KIOSK_PORT=8090


# ---- Chat ------------------------------------------------------------
# Web search: route OpenAI chat through the Responses API + web_search
# tool so answers can include current / real-time info instead of only
# the model's training-cutoff knowledge. Adds ~3-6 s latency per
# question. Set to false for fast, cutoff-limited answers.
# CHAT_WEB_SEARCH=true


# ---- TTS streaming (Piper) -------------------------------------------
# Default "true" streams Piper PCM straight to aplay so audio starts
# within ~300 ms instead of ~1.5-2 s. Set to "false" to fall back to
# the old synthesise-to-WAV-then-play path. Only matters for the Piper
# backend; pyttsx3 ignores this.
# TTS_STREAMING=true


# ---- Hailo Whisper (NPU speech-to-text) ------------------------------
# CHAT_ASR_BACKEND lives in config.py and defaults to "auto" -- it
# picks Hailo automatically when the right files are on disk.
#
# RECOMMENDED on HailoRT >= 5.2.0: set HAILO_WHISPER_HEF to a combined
# Whisper HEF (encoder + decoder in one file) and Hailo's native
# Speech2Text API handles everything internally -- no .npy files, no
# add_embed flag, no patches to hailo-apps.
# HAILO_WHISPER_HEF=/usr/local/hailo/resources/models/hailo10h/Whisper-Small.hef
#
# Legacy path (HailoRT < 5.2 or separate encoder/decoder HEFs):
# To use a non-default variant or paths, uncomment:
# HAILO_WHISPER_MODEL=base                  # "tiny" | "base" | "tiny.en"
# HAILO_WHISPER_ENCODER_HEF=/path/to/whisper-base-encoder.hef
# HAILO_WHISPER_DECODER_HEF=/path/to/whisper-base-decoder.hef
# HAILO_WHISPER_NPY_DIR=/path/to/whisper-base-assets
# HAILO_WHISPER_ADD_EMBED=false            # true for Hailo-8/8L, false for Hailo-10H
# See docs/hailo-whisper.md for the install (hailo-apps isn't on
# PyPI -- clone the repo and `pip install -e '.[speech-rec]'`). The
# speech-rec extra auto-downloads the HEFs + .npy assets on first run.


# ---- Hailo-Ollama ----------------------------------------------------
# Skip auto-starting hailo-ollama when OPENAI_API_KEY is set (default).
# Flip to 1 to always preload it -- gives instant fallback at the cost
# of ~2.5 GB resident memory.
# PRELOAD_OLLAMA=0
# OLLAMA_URL=http://localhost:8000


# ---- Mic / speaker (already overridable on the command line) ---------
# SD_DEVICE=1
# AUDIO_OUTPUT_DEVICE=plughw:CARD=PowerConf,DEV=0


# ---- External display API --------------------------------------------
# When a recognised person starts a session ECHO POSTs
#   {"state":"on","employee_id":"E0001","full_name":"..."}
# and when the session ends (bye, idle timeout, or X) it POSTs
#   {"state":"off"}
# with header X-API-Key. Leave DISPLAY_API_URL empty to turn this off.
# For local testing run `python mock_display_api.py --host 0.0.0.0` on
# your laptop and point the URL at it.
# DISPLAY_API_URL=http://192.168.1.50:8765/api/display
# DISPLAY_API_KEY=test-key
# DISPLAY_API_TIMEOUT_SEC=3


# ---- Wake word -------------------------------------------------------
# Minimum Vosk confidence for the wake phrase. Raise if ECHO wakes on its
# own; lower if the real phrase stops working. The journal prints the
# confidence of every attempt ("[wake-word] rejected ..." / "WAKE on ...").
# WAKE_WORD_MIN_CONF=0.80
# Ignore wake triggers this many seconds after a session ends.
# WAKE_COOLDOWN_AFTER_IDLE_SEC=4
# Set false if the touchscreen produces ghost taps that wake ECHO.
# WAKE_ON_TOUCH=true


# ---- Hologram app (employee details + face photo) ---------------------
# Each employee is POSTed as multipart form data (employee_id, full_name,
# image) to this URL. New registrations are sent right away; anyone
# missed while the app was offline is retried in-kiosk and by start.sh
# before every launch. Manual run: python hologram_sync.py --status
# HOLOGRAM_SYNC_URL=http://192.168.1.50:8765/api/employees
# HOLOGRAM_API_KEY=          # defaults to DISPLAY_API_KEY
# HOLOGRAM_SYNC_ON_START=1   # 0 = skip the start-up sync
# HOLOGRAM_RETRY_SEC=600     # 0 = no in-kiosk retry
# HOLOGRAM_SEND_WITHOUT_PHOTO=false
# HOLOGRAM_BACKFILL_ON_RECOGNITION=true
